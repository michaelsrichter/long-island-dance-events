{
  "name": "li-dance-events-website",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Astro starter for volunteer dance and community organization websites.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-cms-config.mjs && astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:server": "node scripts/live/build-server.mjs",
    "prebuild": "node scripts/build-cms-config.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "typecheck": "astro check",
    "validate:content": "astro sync",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "test:size": "node scripts/check-site-size.mjs",
    "lighthouse": "lhci autorun",
    "cms:config": "node scripts/build-cms-config.mjs",
    "cms:local": "decap-server",
    "copy:cms": "node scripts/copy-cms.mjs",
    "postinstall": "node scripts/copy-cms.mjs && node scripts/build-cms-config.mjs",
    "ci": "npm run check && npm run test && npm run build && npm run test:size && npm run test:links",
    "test:smoke": "node scripts/smoke.mjs",
    "geocode": "node scripts/geocode-venues.mjs",
    "ingest": "tsx ingest/run.ts",
    "test:py": "python -m unittest discover -s ingest/pdf -p \"test_*.py\"",
    "build-now": "node scripts/build-now.mjs",
    "lockfile:normalize": "node scripts/normalize-lockfile.mjs",
    "lockfile:check": "node scripts/normalize-lockfile.mjs --check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.0",
    "leaflet": "^1.9.4",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "decap-cms": "^3.17.1",
    "decap-server": "^3.11.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
