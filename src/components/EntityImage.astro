---
/**
 * A directory photo or logo (venues, bands, teachers, organizers, styles), optimized to WebP.
 * Photos are always cropped to 16:9 around their focus point and made at the same two widths, so the
 * card, the page top and the gallery share one set of files (keeps the build small).
 * Logos keep their shape and are never cropped. Settings: entityImageOptions() in lib/directory.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { entityImageOptions, logoSizes } from '../lib/directory';
interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: 'photo' | 'logo';
  focus?: string | undefined;
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { src, alt, kind = 'photo', focus, sizes, loading = 'lazy', class: className } = Astro.props;
const opts = entityImageOptions(src, kind, focus);
// A logo is never shown wider than its largest file (SVGs scale cleanly, so they are left alone).
const finalSizes = kind === 'logo' && opts.format !== 'svg' ? logoSizes(sizes, opts.width) : sizes;
---
<Image
  src={src}
  alt={alt}
  {...opts}
  sizes={opts.format === 'svg' ? undefined : finalSizes}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
/>
