---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getEventGroups } from '../../lib/content';
import { linksOf } from '../../lib/links';
import { PERFORMER_TYPE_LABELS, PERFORMER_TYPES } from '../../lib/schemas';
import { breadcrumbJsonLd } from '../../lib/seo';

const people = (await getCollection('performers')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const { upcoming } = await getEventGroups();
const count = (id: string) => new Set(upcoming.filter((e) => e.performers.some((p) => p.id === id)).map((e) => e.eventId)).size;
const groups = PERFORMER_TYPES.map((t) => ({ t, list: people.filter((p) => p.data.type === t) })).filter((g) => g.list.length);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Bands and DJs', href: '/performers/' },
];
const heading = { band: 'Bands', dj: 'DJs', solo: 'Singers and solo acts' } as const;
---
<BaseLayout title="Bands and DJs for dancing on Long Island" description={`${people.length} bands, singers and DJs who play for dancers in Nassau and Suffolk.`} pageType="performers" jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <PageHeader title="Bands and DJs" lede="Live music and DJs named in the listings. Pick one to see where they play next." crumbs={crumbs} />
  <div class="container section stack-l">
    {groups.map(({ t, list }) => (
      <section aria-labelledby={`g-${t}`}>
        <h2 id={`g-${t}`}>{heading[t]}</h2>
        <ul class="grid grid--3 mt-5 person-grid">
          {list.map((p) => <PersonCard name={p.data.name} href={`/performers/${p.id}/`} kicker={PERFORMER_TYPE_LABELS[t]} icon={t === 'dj' ? 'music' : 'star'} links={linksOf(p.data)} upcomingCount={count(p.id)} note={p.data.genres.slice(0, 3).join(', ')} />)}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
