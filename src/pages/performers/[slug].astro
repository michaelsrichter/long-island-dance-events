---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventSeriesList from '../../components/EventSeriesList.astro';
import PersonLinks from '../../components/PersonLinks.astro';
import { upcomingFor } from '../../lib/content';
import { linksOf } from '../../lib/links';
import { PERFORMER_TYPE_LABELS } from '../../lib/schemas';
import { breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getCollection('performers')).map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}
const { person } = Astro.props;
const p = person.data;
const events = await upcomingFor((e) => e.performers.some((x) => x.id === person.id));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Bands and DJs', href: '/performers/' },
  { name: p.name, href: `/performers/${person.id}/` },
];
const lede = p.description ?? `${PERFORMER_TYPE_LABELS[p.type]}${p.genres.length ? ` · ${p.genres.join(', ')}` : ''}`;
---
<BaseLayout title={p.seoTitle ?? `${p.name}: where to dance to them on Long Island`} description={p.seoDescription ?? `${p.name} (${PERFORMER_TYPE_LABELS[p.type]}). Upcoming dances and gigs in Nassau and Suffolk.`} pageType="person" jsonLd={[{ '@context': 'https://schema.org', '@type': p.type === 'band' ? 'MusicGroup' : 'Person', name: p.name, genre: p.genres, sameAs: linksOf(p).map((l) => l.url) }, breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <PageHeader title={p.name} lede={lede} crumbs={crumbs}>
    <PersonLinks links={linksOf(p)} name={p.name} variant="buttons" location="performer" class="mt-5" />
  </PageHeader>
  <div class="container section stack-l">
    <section aria-labelledby="on-h">
      <h2 id="on-h">Where to dance to {p.name} next</h2>
      <div class="mt-5"><EventSeriesList events={events} empty={`No upcoming events with ${p.name} are listed right now`} /></div>
    </section>
  </div>
</BaseLayout>
