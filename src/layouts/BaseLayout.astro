---
import '@fontsource/fraunces/latin-700.css';
import '../styles/global.css';
import frauncesUrl from '@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Announcement from '../components/Announcement.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getSettings } from '../lib/content';
import { jsonLdString, organizationJsonLd, websiteJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  imageAlt?: string | undefined;
  ogType?: 'website' | 'article' | 'event';
  jsonLd?: unknown[];
  noindex?: boolean;
  pageType: string;
  /** Use the full title without the site-name suffix. */
  exactTitle?: boolean;
  /** Extra data-* attributes for <html> (used by analytics on event pages). */
  htmlData?: Record<string, string>;
  bodyClass?: string;
}
const { title, description, image, imageAlt, ogType = 'website', jsonLd = [], noindex = false, pageType, exactTitle = false, htmlData = {}, bodyClass } = Astro.props;
const settings = await getSettings();
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();
const fullTitle = exactTitle || title.includes(settings.shortName) || title.includes(settings.siteName) ? title : `${title} | ${settings.siteName}`;
const ogImage = new URL(image ?? '/og/default.png', site).toString();
const allowIndexing = process.env.ALLOW_INDEXING === 'true';
const robots = noindex || !allowIndexing ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const structured = [organizationJsonLd(settings, site), ...(Astro.url.pathname === '/' ? [websiteJsonLd(settings, site)] : []), ...jsonLd];

const analytics = {
  ga: import.meta.env.PUBLIC_GA4_ID ?? '',
  clarity: import.meta.env.PUBLIC_CLARITY_ID ?? '',
  consent: import.meta.env.PUBLIC_ANALYTICS_CONSENT_MODE ?? 'opt-in',
  telemetry: import.meta.env.PUBLIC_TELEMETRY_ENDPOINT === 'off' ? '' : import.meta.env.PUBLIC_TELEMETRY_ENDPOINT || '/api/telemetry',
  release: import.meta.env.PUBLIC_RELEASE ?? 'local',
};
---
<!doctype html>
<html
  lang="en-US"
  data-page-type={pageType}
  data-ga-id={analytics.ga || undefined}
  data-clarity-id={analytics.clarity || undefined}
  data-consent-mode={analytics.consent}
  data-telemetry={analytics.telemetry}
  data-release={analytics.release}
  {...htmlData}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('site-theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}})()</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {pageType !== '404' && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#24162f" />
    <link rel="alternate" type="application/rss+xml" title={`${settings.shortName} upcoming events`} href="/events/rss.xml" />
    <link rel="alternate" type="text/calendar" title={`${settings.shortName} events calendar`} href="/events/club-events.ics" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType === 'event' ? 'website' : ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${settings.siteName}: ${settings.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {structured.map((data) => <script type="application/ld+json" set:html={jsonLdString(data)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Announcement />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} />
    <ConsentBanner />
    <div class="toast" role="status" aria-live="polite" aria-atomic="true" data-toast></div>
    <script>
      import '../scripts/analytics';
      import '../scripts/relative';
      import '../scripts/expire';
      import '../scripts/collapse';
      import '../scripts/theme';
    </script>
  </body>
</html>
