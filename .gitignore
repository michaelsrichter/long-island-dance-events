# Dependencies
node_modules/

# Build output
dist/
dist-server/
server/site/
.astro/

# Self-hosted Decap CMS bundle (copied from node_modules on install)
public/admin/decap-cms.js

# Test and audit artifacts
test-results/
playwright-report/
blob-report/
.lighthouseci/
coverage/

# Azure Functions local settings and secrets
api/local.settings.json
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Generated from cms/config.yml by scripts/build-cms-config.mjs
public/admin/config.yml

# Ingest cache (downloaded source files; never commit)
.cache/
__pycache__/

# Local scratch and tool output
.tmp/
.playwright-mcp/

# SQLite report database built by catalog/scripts/build-sqlite.ts (rebuilt every run; never commit)
data/*.sqlite
data/*-report.md

# Written by the server deploy workflow (the deployed commit); never committed
server/version.json
server/local.settings.json
