---
import Icon from './Icon.astro';
import PersonLinks from './PersonLinks.astro';
import type { ExternalLink } from '../lib/links';
interface Props {
  name: string;
  href: string;
  /** Short label above the name, e.g. "DJ" or "Teacher". */
  kicker: string;
  icon?: 'people' | 'music' | 'pin' | 'star';
  links?: ExternalLink[];
  upcomingCount?: number;
  note?: string | undefined;
}
const { name, href, kicker, icon = 'people', links = [], upcomingCount = 0, note } = Astro.props;
---
<li class="card person-card">
  <span class="avatar avatar--placeholder" aria-hidden="true"><Icon name={icon} /></span>
  <div>
    <p class="card__kicker">{kicker}{upcomingCount > 0 ? ` · ${upcomingCount} coming up` : ''}</p>
    <h3><a href={href}>{name}</a></h3>
    {note && <p class="muted">{note}</p>}
    <PersonLinks links={links} name={name} max={3} location="directory" />
  </div>
</li>
