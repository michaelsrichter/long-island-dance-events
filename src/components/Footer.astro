---
import type { Settings } from '../lib/content';
import ThemeSwitch from './ThemeSwitch.astro';
import { buildNow } from '../lib/content';
interface Props {
  settings: Settings;
}
const { settings: s } = Astro.props;
const year = new Date().getFullYear();
const hasConsent = Boolean(import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_CLARITY_ID);
const issues = `${s.repoUrl}/issues/new/choose`;
const updated = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(buildNow());
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <section aria-labelledby="footer-find">
        <h2 id="footer-find">Find events</h2>
        <ul>
          <li><a href="/events/">All upcoming events</a></li>
          <li><a href="/events/?when=today">Tonight and today</a></li>
          <li><a href="/events/?when=weekend">This weekend</a></li>
          <li><a href="/events/?category=class-lesson">Classes and lessons</a></li>
          <li><a href="/events/?category=live-music">Live music</a></li>
          <li><a href="/events/calendar/">Month calendar</a></li>
          <li><a href="/events/map/">Map</a></li>
        </ul>
      </section>
      <section aria-labelledby="footer-browse">
        <h2 id="footer-browse">Browse</h2>
        <ul>
          <li><a href="/venues/">Venues</a></li>
          <li><a href="/organizers/">Studios, clubs and organizers</a></li>
          <li><a href="/instructors/">Teachers</a></li>
          <li><a href="/performers/">Bands and DJs</a></li>
          <li><a href="/styles/">Dance styles explained</a></li>
          <li><a href="/towns/">Town by town</a></li>
          <li><a href="/events/past/">Past events</a></li>
        </ul>
      </section>
      <section aria-labelledby="footer-about">
        <h2 id="footer-about">About this site</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/sources/">Where listings come from</a></li>
          <li><a href="/faq/">Frequently Asked Questions</a></li>
          <li><a href={issues} rel="noopener">Add, fix or remove a listing</a></li>
          <li><a href="/events/all.ics" data-track="add_to_calendar" data-track-method="subscribe_feed">Subscribe in your calendar app</a></li>
          <li><a href="/events/rss.xml">RSS feed</a></li>
        </ul>
      </section>
      <section aria-labelledby="footer-account">
        <h2 id="footer-account">Your account</h2>
        <ul>
          <li><a href="/account/" data-account-link><span data-account-label>Sign in or create an account</span></a></li>
          <li data-account-when="in" hidden><a href="/saved/">Saved events</a></li>
          <li data-account-when="admin" hidden><a href="/moderate/">Moderation queue</a></li>
          <li data-account-when="in" hidden><a href="/.auth/logout" data-account-signout>Sign out</a></li>
          <li><a href="/community-rules/">Community rules</a></li>
          <li><a href="/privacy/#accounts">What we keep about you</a></li>
        </ul>
      </section>
    </div>
    <p class="site-footer__note">We collect listings from public calendars and organizers. Details can change, so <strong>always check with the organizer before you go</strong>. Listings last updated <time datetime={buildNow().toISOString()}>{updated}</time>.</p>
    <ThemeSwitch variant="choice" location="footer" class="theme-choice--footer" />
    <div class="site-footer__base">
      <p>© {year} {s.siteName}. A free community guide. Not connected with the events listed.</p>
      <p>
        <a href="/privacy/">Privacy</a>
        <span aria-hidden="true"> · </span>
        <a href="/sources/#takedown">Takedown requests</a>
        {hasConsent && <span aria-hidden="true"> · </span>}
        {hasConsent && <button type="button" class="link-button js-only" data-consent-open>Privacy choices</button>}
      </p>
    </div>
  </div>
</footer>
