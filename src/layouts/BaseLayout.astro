---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getSettings } from '../lib/content';
import { jsonLdString, organizationJsonLd, websiteJsonLd } from '../lib/seo';
import { PAGE_IMAGE_IDS, pageImage, type PageImageId } from '../lib/entity-meta';
const isPageImage = (t: string): t is PageImageId => (PAGE_IMAGE_IDS as readonly string[]).includes(t);

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** MIME type of `image` (share pictures for directory pages are JPEG). */
  imageType?: 'image/png' | 'image/jpeg';
  /** Up to two "label: value" pairs shown under link previews in Slack, Discord and X. */
  labels?: { label: string; data: string }[];
  ogType?: 'website' | 'article' | 'event';
  jsonLd?: unknown[];
  noindex?: boolean;
  /** Robots meta value for indexable builds, e.g. "noindex, follow" for past events (overrides `noindex`). */
  robots?: string | undefined;
  pageType: string;
  /** Use the full title without the site-name suffix. */
  exactTitle?: boolean;
  /** Extra data-* attributes for <html> (used by analytics on event pages). */
  htmlData?: Record<string, string>;
  bodyClass?: string;
}
const { title, description, image, imageAlt, imageType = 'image/png', labels = [], ogType = 'website', jsonLd = [], noindex = false, robots: robotsOverride, pageType, exactTitle = false, htmlData = {}, bodyClass } = Astro.props;
const settings = await getSettings();
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();
const fullTitle = exactTitle || title.includes(settings.shortName) || title.includes(settings.siteName) ? title : `${title} | ${settings.siteName}`;
const ogImage = new URL(image ?? (isPageImage(pageType) ? pageImage(pageType).src : '/og/default.png'), site).toString();
const ogImageAlt = imageAlt ?? (isPageImage(pageType) ? pageImage(pageType).alt : `${settings.siteName}: ${settings.tagline}`);
const allowIndexing = process.env.ALLOW_INDEXING === 'true';
const robots = !allowIndexing ? 'noindex, nofollow' : robotsOverride ?? (noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1');
// Search engine ownership checks (optional; the owner can also verify with a DNS record).
const verify = { google: import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '', bing: import.meta.env.PUBLIC_BING_SITE_VERIFICATION ?? '' };
const structured = [organizationJsonLd(settings, site), ...(Astro.url.pathname === '/' ? [websiteJsonLd(settings, site)] : []), ...jsonLd];

const analytics = {
  ga: import.meta.env.PUBLIC_GA4_ID ?? '',
  clarity: import.meta.env.PUBLIC_CLARITY_ID ?? '',
  consent: import.meta.env.PUBLIC_ANALYTICS_CONSENT_MODE ?? 'opt-in',
  telemetry: import.meta.env.PUBLIC_TELEMETRY_ENDPOINT === 'off' ? '' : import.meta.env.PUBLIC_TELEMETRY_ENDPOINT || '/api/telemetry',
  release: import.meta.env.PUBLIC_RELEASE ?? 'local',
};
---
<!doctype html>
<html
  lang="en-US"
  data-page-type={pageType}
  data-ga-id={analytics.ga || undefined}
  data-clarity-id={analytics.clarity || undefined}
  data-consent-mode={analytics.consent}
  data-telemetry={analytics.telemetry}
  data-release={analytics.release}
  {...htmlData}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('site-theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}})()</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {pageType !== '404' && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    {verify.google && <meta name="google-site-verification" content={verify.google} />}
    {verify.bing && <meta name="msvalidate.01" content={verify.bing} />}
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="alternate" type="application/rss+xml" title={`${settings.shortName} upcoming events`} href="/events/rss.xml" />
    <link rel="alternate" type="text/calendar" title={`${settings.siteName} calendar`} href="/events/all.ics" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType === 'event' ? 'website' : ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={image ? imageType : 'image/png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {labels.slice(0, 2).map((l, i) => (
      <>
        <meta name={`twitter:label${i + 1}`} content={l.label} />
        <meta name={`twitter:data${i + 1}`} content={l.data} />
      </>
    ))}
    <meta name="generator" content={Astro.generator} />
    {structured.map((data) => <script type="application/ld+json" set:html={jsonLdString(data)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} />
    <ConsentBanner />
    <div class="toast" role="status" aria-live="polite" aria-atomic="true" data-toast></div>
    <script>
      import '../scripts/analytics';
      import '../scripts/relative';
      import '../scripts/expire';
      import '../scripts/collapse';
      import '../scripts/theme';
    </script>
  </body>
</html>
