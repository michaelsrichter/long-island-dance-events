---
/**
 * Auto-rotating photo slideshow (progressive enhancement).
 * Without JavaScript it is a swipeable row of photos. With JavaScript it adds autoplay (paused on hover,
 * focus, when off screen and for people who prefer reduced motion), Pause/Play, Previous/Next and dots.
 * Photos are shown whole inside the frame; a blurred copy fills any space around them, so nothing is cut off.
 */
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './Icon.astro';

export interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  credit?: string | undefined;
  creditUrl?: string | undefined;
  focus?: string | undefined;
  /** Optional silent clip; `src` is its poster. */
  video?: string | undefined;
}
interface Props {
  slides: Slide[];
  label: string;
  sizes: string;
  /** Analytics location. */
  location?: string;
  class?: string;
}
const { slides, label, sizes, location = 'slideshow', class: className } = Astro.props;
const n = slides.length;
// Only very wide or very tall photos are trimmed (gently, around their focus point); others show whole.
const cropAspect = (s: Slide) => {
  const a = s.src.width / s.src.height;
  return a > 2 ? 2 : a < 0.8 ? 0.8 : undefined;
};
---
{n > 0 && (
  <section class:list={['slideshow', className]} data-slideshow data-track-location={location} aria-roledescription="carousel" aria-label={label}>
    <div class="slideshow__track" data-slideshow-track aria-live="off" tabindex="0" aria-label="Photos. Scroll sideways or use the buttons below.">
      {slides.map((s, i) => (
        <div class="slideshow__slide" data-slide role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${n}`}>
          <figure class="slideshow__figure">
            <div class="slideshow__frame">
              <ResponsiveImage class="slideshow__backdrop" src={s.src} alt="" widths={[48]} sizes="48px" aspect={cropAspect(s)} focus={s.focus} loading={i === 0 ? 'eager' : 'lazy'} />
              <ResponsiveImage class="slideshow__img" src={s.src} alt={s.alt} widths={[480, 720, 960, 1280]} sizes={sizes} aspect={cropAspect(s)} focus={s.focus} loading={i === 0 ? 'eager' : 'lazy'} />
              {s.video && (
                <video class="slideshow__video js-only" data-slide-video data-src={s.video} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
              )}
              {s.video && <span class="slideshow__badge" aria-hidden="true"><Icon name="play" />Video</span>}
            </div>
            {(s.caption || s.credit) && (
              <figcaption class="slideshow__caption">
                {s.caption && <span>{s.caption} </span>}
                {s.credit && <span class="slideshow__credit">Photo: {s.creditUrl ? <a href={s.creditUrl} rel="noopener">{s.credit}</a> : s.credit}</span>}
              </figcaption>
            )}
          </figure>
        </div>
      ))}
    </div>
    {n > 1 && (
      <div class="slideshow__controls js-only">
        <button type="button" class="slideshow__btn" data-slideshow-prev aria-label="Previous photo"><Icon name="arrow" class="icon-flip" /></button>
        <button type="button" class="slideshow__btn" data-slideshow-toggle aria-label="Pause slideshow">
          <Icon name="pause" class="slideshow__icon-pause" /><Icon name="play" class="slideshow__icon-play" />
        </button>
        <div class="slideshow__dots" role="group" aria-label="Choose a photo" hidden={n > 8}>
          {slides.map((_, i) => <button type="button" class="slideshow__dot" data-slideshow-dot={String(i)} aria-label={`Show photo ${i + 1} of ${n}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
        {n > 8 && <p class="slideshow__count" data-slideshow-count aria-hidden="true">1 / {n}</p>}
        <button type="button" class="slideshow__btn" data-slideshow-next aria-label="Next photo"><Icon name="arrow" /></button>
      </div>
    )}
  </section>
)}
<script>
  import '../scripts/slideshow';
</script>
