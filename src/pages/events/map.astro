---
import 'leaflet/dist/leaflet.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventViews from '../../components/EventViews.astro';
import RelativeWhen from '../../components/RelativeWhen.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { getEventGroups, type ResolvedEvent } from '../../lib/content';
import { isDanceLevel } from '../../lib/dancing';
import { groupByPlace } from '../../lib/map-places';
import { formatDateShort } from '../../lib/time';
import { breadcrumbJsonLd } from '../../lib/seo';

const { upcoming } = await getEventGroups();
const { places, unplaced } = groupByPlace(upcoming.map((e) => ({ ...e, venueId: e.venue?.id })));
const MAX_EVENTS = 3;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Events', href: '/events/' },
  { name: 'Map', href: '/events/map/' },
];
/** Dances and live music first, like the event list; classes and everything are one tap away. */
const types = [
  { value: 'dance', label: 'Dances & live music' },
  { value: 'class', label: 'Classes' },
  { value: 'all', label: 'Everything' },
];
const whens = [
  { value: 'all', label: 'All upcoming' },
  { value: 'week', label: 'Next 7 days' },
  { value: 'month', label: 'This month' },
];
/** dance = dances and live music with dancing; class = classes; listen = concerts where people mostly listen. */
const kind = (e: ResolvedEvent) => (e.category === 'class-lesson' ? 'class' : isDanceLevel(e.dancing.level) ? 'dance' : 'listen');
const placeKind = (list: ResolvedEvent[]) => (list.some((e) => kind(e) === 'dance') ? 'dance' : list.some((e) => kind(e) === 'class') ? 'class' : 'listen');
const when = (e: ResolvedEvent) => `${formatDateShort(e.date)}${e.timeLabel ? ` · ${e.timeLabel.split(' to ')[0]}` : ''}`;
---
<BaseLayout
  title="Map of dance events on Long Island"
  description={`See where to dance in Nassau and Suffolk: ${places.length} places with upcoming dances, classes and live music, with dates and directions.`}
  pageType="map"
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <PageHeader title="Dance map" lede="Find dancing near you. Star pins have dances or live music you can dance to. Round pins only have classes or concerts." crumbs={crumbs}>
    <EventViews current="map" />
  </PageHeader>

  <div class="container section stack-l">
    <form class="filters js-only" data-map-filters aria-label="Filter the map">
      <fieldset>
        <legend>Type of event</legend>
        <div class="quick-views">
          {types.map((h, i) => (
            <label class="chip"><input type="radio" name="type" value={h.value} checked={i === 0} /><span>{h.label}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>When</legend>
        <div class="quick-views">
          {whens.map((w, i) => (
            <label class="chip"><input type="radio" name="when" value={w.value} checked={i === 0} /><span>{w.label}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="btn-row filters__foot">
        <p class="result-count" data-map-count aria-live="polite">{places.length} places shown</p>
        <button type="button" class="btn btn--secondary btn--small" data-map-locate><Icon name="pin" />Show places near me</button>
      </div>
    </form>

    <div class="map-layout">
      <div class="map-panel js-only">
        <div class="events-map" data-events-map role="region" aria-label="Map of upcoming events. The list of places has the same information."></div>
        <ul class="host-legend mt-3" aria-label="What the pins mean">
          <li><span class="map-pin-key map-pin-key--home" aria-hidden="true"><Icon name="star" /></span>Dances or live music</li>
          <li><span class="map-pin-key map-pin-key--community" aria-hidden="true"></span>Classes or concerts only</li>
        </ul>
      </div>

      <div class="map-list">
        {places.length === 0 ? (
          <EmptyState title="No upcoming events are on the map right now"><p><a href="/events/">See all events</a></p></EmptyState>
        ) : (
          <ol class="map-places" data-upcoming-list="map" aria-label="Places with upcoming events">
            {places.map((p) => {
              const k = placeKind(p.events);
              return (
                <li class="map-place" id={`place-${p.id}`} data-map-place data-lat={String(p.lat)} data-lng={String(p.lng)} data-host={k} data-name={p.name}>
                  <div class="map-place__head">
                    <span class:list={['map-pin-key', `map-pin-key--${k === 'dance' ? 'home' : 'community'}`]} aria-hidden="true">{k === 'dance' && <Icon name="star" />}</span>
                    <div>
                      <h2 class="map-place__name">{p.venueId ? <a href={`/venues/${p.venueId}/`}>{p.name}</a> : p.name}</h2>
                      <p class="muted">{[p.address, p.town].filter(Boolean).join(', ')}<span class="map-place__distance" data-map-distance></span></p>
                    </div>
                  </div>
                  <ul class="map-place__events">
                    {p.events.map((e, i) => (
                      <li data-event data-map-event data-host={kind(e)} data-date={e.date} data-end={String(e.end.getTime())} hidden={i >= MAX_EVENTS}>
                        <a href={e.url} data-track="select_event" data-track-location="map">{e.title}</a>
                        <span class="map-place__when">{when(e)}</span>
                        <span class="map-place__badges">
                          <span class:list={['cat-badge', 'cat-badge--small', `cat-badge--${e.category}`]}>{e.categoryLabel}</span>
                          <RelativeWhen start={e.start} end={e.end} allDay={e.timeTba} />
                        </span>
                      </li>
                    ))}
                  </ul>
                  {p.events.length > MAX_EVENTS && <p class="muted map-place__more" data-map-more>More dates on the <a href={p.venueId ? `/venues/${p.venueId}/` : '/events/'}>{p.venueId ? 'venue page' : 'events list'}</a>.</p>}
                  <p class="btn-row map-place__actions">
                    <button type="button" class="btn btn--secondary btn--small js-only" data-map-focus><Icon name="pin" />Show on map</button>
                    <a class="btn btn--secondary btn--small" href={`https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`} target="_blank" rel="noopener" data-track="get_directions" data-track-method="google" data-track-location="map"><Icon name="directions" />Directions<span class="visually-hidden"> to {p.name} (opens in a new tab)</span></a>
                  </p>
                </li>
              );
            })}
          </ol>
        )}
        <div data-map-empty hidden>
          <EmptyState title="Nothing matches those filters" icon="info"><p>Try "Everything" or "All upcoming".</p></EmptyState>
        </div>
        {unplaced.length > 0 && (
          <section class="card mt-5" aria-labelledby="unplaced-h">
            <h2 id="unplaced-h" class="h4">Also coming up (place not on the map yet)</h2>
            <ul class="map-place__events mt-3" data-upcoming-list="map_unplaced">
              {unplaced.map((e) => (
                <li data-event data-host={kind(e)} data-date={e.date} data-end={String(e.end.getTime())}>
                  <a href={e.url} data-track="select_event" data-track-location="map">{e.title}</a>
                  <span class="map-place__when">{when(e)}{e.location.town ? ` · ${e.location.town}` : ''}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    <p class="muted map-credit">Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>. Venue locations from the U.S. Census Bureau geocoder and OpenStreetMap. <a href="https://www.openstreetmap.org/fixthemap" rel="noopener">Report a map problem</a>.</p>
  </div>
</BaseLayout>
<script>
  import '../../scripts/events-map';
</script>
