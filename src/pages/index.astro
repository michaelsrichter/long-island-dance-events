---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ShowMore from '../components/ShowMore.astro';
import RelativeDay from '../components/RelativeDay.astro';
import { byDay, getEventGroups, getSettings } from '../lib/content';
import { photos } from '../lib/photos';
import { formatDateLong } from '../lib/time';

const settings = await getSettings();
const { upcoming, tonight, weekend, nextSevenDays, today, weekendRange } = await getEventGroups();
const weekendLater = weekend.filter((e) => e.date > today);
const shown = new Set([...tonight, ...weekendLater].map((e) => e.slug));
const later = nextSevenDays.filter((e) => !shown.has(e.slug));
const laterDays = byDay(later);
const SHOW = 6;
const laterIndex = new Map(later.map((e, i) => [e.slug, i]));
const styles = (await getCollection('styles')).sort((a, b) => a.data.order - b.data.order);
const styleCounts = styles.map((s) => ({ s, n: upcoming.filter((e) => e.styles.some((x) => x.id === s.id)).length })).filter((x) => x.n > 0);
const places = new Set(nextSevenDays.map((e) => e.venue?.id ?? e.location.town)).size;
const quick = [
  { href: '/events/?when=today', label: 'Today', count: tonight.length, icon: 'clock' as const },
  { href: '/events/?when=weekend', label: 'This weekend', count: weekend.length, icon: 'calendar' as const },
  { href: '/events/?category=class-lesson', label: 'Classes', count: upcoming.filter((e) => e.category === 'class-lesson').length, icon: 'people' as const },
  { href: '/events/?category=live-music', label: 'Live music', count: upcoming.filter((e) => e.category === 'live-music').length, icon: 'star' as const },
  { href: '/events/map/', label: 'Map', count: undefined, icon: 'pin' as const },
];
---
<BaseLayout title={`${settings.siteName}: dances, classes and live music in Nassau and Suffolk`} description={settings.description} pageType="home" exactTitle>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container home-hero home-hero--aggregator">
      <div class="home-hero__intro">
        <p class="hero__eyebrow"><Icon name="music" />Nassau and Suffolk · Updated every week</p>
        <h1 id="hero-title">Find a place to dance on Long Island</h1>
        <p class="hero__lede">Social dances, classes and live music from local calendars, all in one list. Swing, ballroom, Latin, hustle, tango, country and more.</p>
        <form class="hero-search" action="/events/" method="get" role="search">
          <label for="home-q" class="visually-hidden">Search events</label>
          <input id="home-q" name="q" type="search" placeholder="Style, town or band" autocomplete="off" />
          <button class="btn btn--primary" type="submit"><Icon name="search" />Search</button>
        </form>
        <p class="hero__stat">{nextSevenDays.length} events in the next 7 days at {places} places.</p>
      </div>
      <nav class="quick-links" aria-label="Quick links">
        <ul>
          {quick.map((q) => (
            <li>
              <a class="quick-link" href={q.href}>
                <Icon name={q.icon} />
                <span class="quick-link__label">{q.label}</span>
                {q.count !== undefined && <span class="quick-link__count">{q.count}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <svg class="swoosh" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 60V30C240 0 480 0 720 22s480 30 720 0v38z" fill="currentColor" /></svg>
  </section>

  <section class="section" aria-labelledby="today-h">
    <div class="container">
      <div class="section__head">
        <div>
          <h2 id="today-h">Today</h2>
          <p>{formatDateLong(today)}</p>
        </div>
        <a class="btn btn--secondary" href="/events/?when=today">Today's list <Icon name="arrow" /></a>
      </div>
      {tonight.length > 0 ? (
        <ul class="event-list" data-upcoming-list="home_today">
          {tonight.map((e) => <EventCard event={e} hideDate />)}
        </ul>
      ) : (
        <EmptyState title="Nothing is listed for today">
          <p>Look at <a href="/events/?when=weekend">this weekend</a> or <a href="/events/">everything coming up</a>.</p>
        </EmptyState>
      )}
      <div data-upcoming-empty hidden>
        <EmptyState title="Today's events have ended"><p>See <a href="/events/">what is coming up next</a>.</p></EmptyState>
      </div>
    </div>
  </section>

  {weekendLater.length > 0 && (
    <section class="section section--tint" aria-labelledby="weekend-h">
      <div class="container">
        <div class="section__head">
          <div>
            <h2 id="weekend-h">This weekend</h2>
            <p>{formatDateLong(weekendRange.from > today ? weekendRange.from : today)} to {formatDateLong(weekendRange.to)}</p>
          </div>
          <a class="btn btn--secondary" href="/events/?when=weekend">All weekend events <Icon name="arrow" /></a>
        </div>
        <div data-upcoming-list="home_weekend" class="stack-l">
          {byDay(weekendLater).map((g) => (
            <section class="day-group" data-month-group aria-labelledby={`w-${g.date}`}>
              <h3 class="day-heading" id={`w-${g.date}`}>{g.label} <RelativeDay date={g.date} /></h3>
              <ul class="event-list">{g.events.map((e) => <EventCard event={e} hideDate headingLevel="h4" />)}</ul>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}

  {later.length > 0 && (
    <section class="section" aria-labelledby="week-h">
      <div class="container">
        <div class="section__head">
          <div>
            <h2 id="week-h">Later this week</h2>
            <p>More dancing in the next 7 days.</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href="/events/">All upcoming events <Icon name="arrow" /></a>
            <a class="btn btn--secondary" href="/events/calendar/"><Icon name="calendar" />Month calendar</a>
          </div>
        </div>
        <div id="home-week" data-upcoming-list="home_week" data-collapse={String(SHOW)} class="stack-l">
          {laterDays.map((g) => (
            <section class="day-group" data-month-group aria-labelledby={`l-${g.date}`}>
              <h3 class="day-heading" id={`l-${g.date}`}>{g.label} <RelativeDay date={g.date} /></h3>
              <ul class="event-list">{g.events.map((e) => <EventCard event={e} hideDate headingLevel="h4" collapsed={(laterIndex.get(e.slug) ?? 0) >= SHOW} />)}</ul>
            </section>
          ))}
        </div>
        <ShowMore target="home-week" total={later.length} limit={SHOW} label="events this week" />
      </div>
    </section>
  )}

  {styleCounts.length > 0 && (
    <section class="section section--sand" aria-labelledby="styles-h">
      <div class="container">
        <div class="section__head">
          <div>
            <h2 id="styles-h">Find your dance style</h2>
            <p>Not sure what a style is? Each page explains it in a few words.</p>
          </div>
          <a class="btn btn--secondary" href="/styles/">Dance styles explained</a>
        </div>
        <ul class="style-grid">
          {styleCounts.map(({ s, n }) => (
            <li><a class="style-chip" href={`/styles/${s.id}/`}><span>{s.data.name}</span><span class="style-chip__count">{n} {n === 1 ? 'event' : 'events'}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="how-h">
    <div class="container info-band">
      <Photo photo={photos.danceFloor} sizes="(min-width: 56rem) 45vw, 92vw" widths={[480, 720, 960]} aspect={4 / 3} caption="Swing dancers in Vancouver, Canada (not a Long Island event)." />
      <div class="stack">
        <h2 id="how-h">How this site works</h2>
        <ol class="steps">
          <li><strong>We gather listings.</strong> Every week, a computer program reads public dance calendars for Long Island. We write a short summary of each event in our own words.</li>
          <li><strong>You pick a dance.</strong> Filter by day, town, dance style, price or level. Every event links to its organizer and to the calendar it came from.</li>
          <li><strong>Check before you go.</strong> We do not run these events. Plans can change, so call or look at the organizer's page first.</li>
        </ol>
        <div class="btn-row">
          <a class="btn btn--secondary" href="/sources/">Where listings come from</a>
          <a class="btn btn--secondary" href={`${settings.repoUrl}/issues/new/choose`} rel="noopener">Add or fix a listing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
