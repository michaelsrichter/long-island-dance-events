---
/** A teacher's or band's name, linked to their own website (or first social page) when they have one. */
import Icon from './Icon.astro';
import type { PersonRef } from '../lib/content';
import { displayHost } from '../lib/links';

interface Props {
  person: PersonRef;
  /** Analytics location, e.g. "card" or "home_next". */
  location?: string;
}
const { person: p, location } = Astro.props;
const link = p.links[0];
---
{link ? (
  <a
    class="person-ext"
    href={link.url}
    target="_blank"
    rel="noopener"
    data-track="outbound_click"
    data-track-method={link.kind}
    data-track-location={location}
    data-track-target={displayHost(link.url)}
  >{p.name}<Icon name="external" /><span class="visually-hidden"> ({link.label}, opens in a new tab)</span></a>
) : (
  p.name
)}
