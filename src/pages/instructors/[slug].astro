---
import type { InferGetStaticPropsType } from 'astro';
import { pageProps } from '../../lib/page-props';
import { getCollection } from '../../lib/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventSeriesList from '../../components/EventSeriesList.astro';
import PersonLinks from '../../components/PersonLinks.astro';
import EntityHeroMedia from '../../components/EntityHeroMedia.astro';
import EntityContact from '../../components/EntityContact.astro';
import EntityGallery from '../../components/EntityGallery.astro';
import { upcomingFor } from '../../lib/content';
import { linksOf } from '../../lib/links';
import { entityImageUrls } from '../../lib/entity-images';
import { breadcrumbJsonLd, instructorJsonLd } from '../../lib/seo';
import CommunityPanel from '../../components/CommunityPanel.astro';
import Reactions from '../../components/Reactions.astro';
import ShareControls from '../../components/ShareControls.astro';
import { instructorMeta } from '../../lib/entity-meta';

export async function getStaticPaths() {
  return (await getCollection('instructors')).map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}
const routeProps = await pageProps<InferGetStaticPropsType<typeof getStaticPaths>>(Astro, getStaticPaths);
if (!routeProps) return Astro.rewrite('/404');
const { person } = routeProps;
const p = person.data;
const events = await upcomingFor((e) => e.instructors.some((i) => i.id === person.id));
const styles = (await getCollection('styles')).filter((s) => p.styles.includes(s.id));
const orgs = (await getCollection('organizers')).filter((o) => p.affiliatedOrganizerIds.includes(o.id));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Teachers', href: '/instructors/' },
  { name: p.name, href: `/instructors/${person.id}/` },
];
const lede = p.description ?? `Dance teacher${styles.length ? ` (${styles.map((s) => s.data.name).join(', ')})` : ''}.`;
const links = linksOf(p);
const site = Astro.site!;
const [photo, ...morePhotos] = p.photos ?? [];
const ld = instructorJsonLd(person.id, p, site, {
  ...(await entityImageUrls(p, site)),
  links,
  styles: styles.map((s) => s.data.name),
  organizations: orgs.map((o) => ({ name: o.data.name, url: new URL(`/organizers/${o.id}/`, site).toString() })),
});
const meta = await instructorMeta(person, events, site);
---
<BaseLayout title={p.seoTitle ?? `${p.name}: dance classes on Long Island`} description={meta.description} image={meta.image.src} imageAlt={meta.image.alt} imageType={meta.image.type} labels={meta.labels} htmlData={{ 'data-entity': `instructor:${person.id}` }} pageType="person" jsonLd={[ld, breadcrumbJsonLd(crumbs, site)]}>
  <PageHeader title={p.name} lede={lede} crumbs={crumbs}>
    {(photo || p.logo) && <EntityHeroMedia slot="media" name={p.name} photo={photo} logo={p.logo} />}
    <Reactions type="instructor" id={person.id} name={p.name} variant="hero" />
    <PersonLinks links={links} name={p.name} variant="buttons" location="instructor" class="mt-5" />
    <div class="btn-row mt-3"><ShareControls share={meta.share} variant="button" buttonClass="btn btn--secondary btn--small" location="instructor" heading={`Share ${p.name}`} /></div>
  </PageHeader>
  <div class="container section stack-l">
    <section aria-labelledby="on-h">
      <h2 id="on-h">Upcoming classes and events</h2>
      <div class="mt-5"><EventSeriesList events={events} empty={`No upcoming events with ${p.name} are listed right now`} /></div>
    </section>
    <EntityContact
      heading="Details and lessons"
      name={p.name}
      location="instructor"
      phone={p.phone}
      email={p.email}
      bookingUrl={p.bookingUrl}
      bookingLabel="Lessons"
      links={links}
      evidence={p.evidence}
      factsSource={p.factsSource}
      logo={p.logo}
      photos={p.photos}
      ownerPrompt="Are you this teacher? Something wrong or missing?"
    >
      {styles.length > 0 && <div><dt>Teaches</dt><dd>{styles.map((s, i) => <>{i > 0 && ', '}<a href={`/styles/${s.id}/`}>{s.data.name}</a></>)}</dd></div>}
      {orgs.length > 0 && <div><dt>Teaches with</dt><dd>{orgs.map((o, i) => <>{i > 0 && ', '}<a href={`/organizers/${o.id}/`}>{o.data.name}</a></>)}</dd></div>}
      {p.town && <div><dt>Based in</dt><dd>{p.town}</dd></div>}
    </EntityContact>
    <EntityGallery photos={morePhotos} heading={`More photos of ${p.name}`} />
    <CommunityPanel type="instructor" id={person.id} name={p.name} />
  </div>
</BaseLayout>
