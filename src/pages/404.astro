---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="Sorry, we could not find that page on Long Island Dance Events." pageType="404" noindex>
  <div class="container--narrow section stack">
    <p class="card__kicker">Error 404</p>
    <h1>Oops, we missed a step</h1>
    <p>We could not find that page. Event pages go away some time after the event is over.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/events/">See upcoming events</a>
      <a class="btn btn--secondary" href="/">Go to the home page</a>
    </div>
    <ul class="mt-5">
      <li><a href="/events/map/">Dance map</a></li>
      <li><a href="/venues/">Venues</a></li>
      <li><a href="/styles/">Dance styles explained</a></li>
      <li><a href="/faq/">Frequently Asked Questions</a></li>
    </ul>
  </div>
</BaseLayout>
