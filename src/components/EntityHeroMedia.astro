---
/** The photo (with the logo on it) or the logo alone, at the top of a venue, band, teacher, organizer or style page. */
import EntityImage from './EntityImage.astro';
import type { EntityImageData } from '../lib/directory';
interface Props {
  photo?: EntityImageData | undefined;
  logo?: EntityImageData | undefined;
}
const { photo, logo } = Astro.props;
---
{photo ? (
  <figure class="entity-hero">
    <div class="entity-hero__frame">
      <EntityImage src={photo.image} alt={photo.alt} focus={photo.focus} sizes="(min-width: 56rem) 26rem, calc(100vw - 2rem)" loading="eager" />
      {logo && <span class="entity-hero__logo"><EntityImage kind="logo" src={logo.image} alt={logo.alt} sizes="4.5rem" loading="eager" /></span>}
    </div>
    {photo.credit && (
      <figcaption class="entity-hero__credit">
        {photo.creditUrl ? <a href={photo.creditUrl} target="_blank" rel="noopener nofollow">{photo.credit}<span class="visually-hidden"> (opens in a new tab)</span></a> : photo.credit}
        {photo.licenseUrl && <> (<a href={photo.licenseUrl} target="_blank" rel="noopener license">license</a>)</>}
      </figcaption>
    )}
  </figure>
) : logo ? (
  <div class="entity-hero entity-hero--logo">
    <EntityImage kind="logo" src={logo.image} alt={logo.alt} sizes="12rem" loading="eager" />
  </div>
) : null}
