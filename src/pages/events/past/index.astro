---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EventViews from '../../../components/EventViews.astro';
import EventCard from '../../../components/EventCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getEventGroups } from '../../../lib/content';
import { breadcrumbJsonLd } from '../../../lib/seo';

const { past } = await getEventGroups();
const years = [...new Set(past.map((e) => e.date.slice(0, 4)))].sort().reverse();
const recent = past.slice(0, 30);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Events', href: '/events/' },
  { name: 'Past events', href: '/events/past/' },
];
---
<BaseLayout title="Past dance events on Long Island" description="Recent past social dances, classes and live music nights in Nassau and Suffolk." pageType="past" jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <PageHeader title="Past events" lede="Events that already happened. Handy for finding a group that dances regularly." crumbs={crumbs}>
    <EventViews current="past" />
  </PageHeader>
  <div class="container section stack-l">
    {years.length > 0 && (
      <nav aria-label="Archive years">
        <h2 class="h3">Browse by year</h2>
        <ul class="btn-row mt-3" role="list">
          {years.map((y) => <li><a class="btn btn--secondary btn--small" href={`/events/past/${y}/`}>{y}</a></li>)}
        </ul>
      </nav>
    )}
    <section aria-labelledby="recent">
      <h2 id="recent">Most recent</h2>
      {recent.length ? (
        <ul class="event-list mt-5">{recent.map((e) => <EventCard event={e} past />)}</ul>
      ) : (
        <EmptyState title="No past events yet"><p>This site is new. Past events will show here after they happen.</p></EmptyState>
      )}
    </section>
  </div>
</BaseLayout>
