---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();
const nav = [
  { href: '/', label: 'Home' },
  { href: '/events/', label: 'Events' },
  { href: '/events/map/', label: 'Map' },
  { href: '/venues/', label: 'Venues' },
  { href: '/styles/', label: 'Dance styles' },
  { href: '/instructors/', label: 'Teachers' },
  { href: '/performers/', label: 'Bands & DJs' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : href === '/events/' ? path.startsWith('/events/') && !path.startsWith('/events/map/') : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${settings.siteName} home`}>
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{settings.siteName}</span>
        <span class="brand__abbr">Nassau &amp; Suffolk · updated weekly</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <Icon name="menu" />
        <span>Menu</span>
      </button>
      <div class="nav__panel" id="nav-panel" data-nav-panel>
        <ul class="nav__list">
          {nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <ThemeSwitch variant="choice" location="menu" class="theme-choice--menu" />
      </div>
    </nav>
    <ThemeSwitch variant="button" location="header" />
    <a class="header-account" href="/account/" data-account-link data-account-header>
      <Icon name="people" />
      <span class="header-account__label" data-account-label>Sign in</span>
    </a>
    {settings.facebookUrl && (
      <a class="header-social" href={settings.facebookUrl} target="_blank" rel="noopener" data-track="outbound_click" data-track-method="facebook" data-track-location="header" data-track-target="facebook.com" title={settings.facebookLabel ?? 'Facebook'}>
        <Icon name="facebook" />
        <span class="visually-hidden">{settings.facebookLabel ?? 'Facebook'} (opens in a new tab)</span>
      </a>
    )}
  </div>
</header>
<script>
  import '../scripts/nav';
  import '../scripts/account-nav';
</script>
