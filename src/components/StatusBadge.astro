---
import Icon from './Icon.astro';
import { STATUS_LABELS } from '../lib/event-core';
import type { EventStatus } from '../lib/schemas';
interface Props {
  status: EventStatus;
}
const { status } = Astro.props;
const icon = status === 'cancelled' ? 'x' : status === 'past' ? 'clock' : status === 'pending-review' ? 'info' : 'check';
---
{status !== 'active' && (
  <span class:list={['status', `status--${status}`]}>
    <Icon name={icon} />
    {STATUS_LABELS[status]}
  </span>
)}
