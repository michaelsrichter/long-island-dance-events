---
import type { ResolvedEvent } from '../lib/content';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import DancingBadge from './DancingBadge.astro';
import TicketDate from './TicketDate.astro';
import RelativeWhen from './RelativeWhen.astro';
import StyleTags from './StyleTags.astro';
import PersonName from './PersonName.astro';
import { formatDateLong } from '../lib/time';

interface Props {
  event: ResolvedEvent;
  headingLevel?: 'h2' | 'h3' | 'h4';
  past?: boolean;
  /** Hide the date ticket (lists already grouped under a date heading). */
  hideDate?: boolean;
  /** Starts hidden behind a "Show more" button (see scripts/collapse.ts). */
  collapsed?: boolean;
}
const { event: e, headingLevel = 'h3', past = false, hideDate = false, collapsed = false } = Astro.props;
const Heading = headingLevel;
const people = [...e.performers, ...e.instructors];
const filterData = {
  'data-event': '',
  'data-collapsed': collapsed ? '' : undefined,
  'data-date': e.date,
  'data-end': String(e.end.getTime()),
  'data-start-min': e.timeTba ? '' : e.startLocal.slice(11),
  'data-status': e.status,
  'data-category': e.category,
  'data-styles': e.styles.map((s) => s.id).join(' '),
  'data-venue': e.venue?.id ?? '',
  'data-town': e.location.town ?? '',
  'data-county': e.location.county ?? '',
  'data-weekday': e.weekday,
  'data-level': e.data.skillLevel,
  'data-price': e.price.free ? 'free' : e.price.known ? 'paid' : 'unknown',
  'data-people': people.map((p) => p.id).join(' '),
  'data-organizer': e.organizer?.id ?? '',
  'data-dancing': e.dancing.level,
  'data-dance-kinds': e.dancing.kinds.join(' '),
};
---
<li class:list={['event-card', `event-card--${e.status}`, `event-card--${e.category}`]} {...filterData}>
  {!hideDate && <TicketDate date={e.date} muted={past || e.status === 'cancelled'} small />}
  <div class="event-card__body">
    <div class="event-card__badges">
      <span class:list={['cat-badge', `cat-badge--${e.category}`]}>{e.categoryLabel}</span>
      {e.category !== 'class-lesson' && <DancingBadge dancing={e.dancing} />}
      <StatusBadge status={e.status} />
      {!past && <RelativeWhen start={e.start} end={e.end} allDay={e.timeTba} />}
    </div>
    <Heading class="event-card__title">
      <a href={e.url} data-track="select_event">
        <span class="visually-hidden">{formatDateLong(e.date)}: </span>{e.title}{e.status === 'cancelled' && <span class="visually-hidden"> (cancelled)</span>}
      </a>
    </Heading>
    <p class="event-card__meta">
      <span><Icon name="clock" />{e.timeLabel ?? 'Time not listed'}</span>
      {e.lessonLabel && e.category !== 'class-lesson' && e.lessonLabel !== e.timeLabel?.split(' to ')[0] && <span><Icon name="people" />Lesson {e.lessonLabel}</span>}
      {e.location.town && <span><Icon name="pin" />{e.location.name ? `${e.location.name}, ${e.location.town}` : e.location.town}</span>}
      {!past && <span><Icon name="ticket" />{e.price.known ? e.price.label : 'Price not listed'}</span>}
    </p>
    {(e.liveActs.length > 0 || e.djs.length > 0 || e.instructors.length > 0 || e.cadence) && (
      <p class="event-card__meta">
        {e.liveActs.length > 0 && <span><Icon name="star" />Live:&nbsp;{e.liveActs.map((p, n) => <>{n > 0 && ', '}<PersonName person={p} location="card" /></>)}</span>}
        {e.djs.length > 0 && <span><Icon name="music" />{e.djs.map((p, n) => <>{n > 0 && ', '}<PersonName person={p} location="card" /></>)}</span>}
        {e.instructors.length > 0 && <span><Icon name="people" />Teacher:&nbsp;{e.instructors.map((p, n) => <>{n > 0 && ', '}<PersonName person={p} location="card" /></>)}</span>}
        {e.cadence && <span><Icon name="calendar" />{e.cadence}</span>}
      </p>
    )}
    <StyleTags styles={e.styles} max={3} />
  </div>
</li>
