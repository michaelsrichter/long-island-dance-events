---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { loginHref } from '../lib/community';
import '../styles/review.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Review center', href: '/moderate/' },
];
const tabs = [
  { id: 'todo', label: 'To do' },
  { id: 'listings', label: 'Held listings' },
  { id: 'publish', label: 'New events' },
  { id: 'sources', label: 'Sources' },
  { id: 'messages', label: 'Messages' },
  { id: 'posts', label: 'Community posts' },
  { id: 'log', label: 'Log' },
];
---
<BaseLayout title="Review center" description="Everything the site owner needs to check, in one place." pageType="moderate" noindex>
  <PageHeader title="Review center" lede="Everything that needs you, in one place. Most weeks this takes about 10 minutes." crumbs={crumbs} />
  <div class="container section review" data-review>
    <p class="spinner" data-review-loading role="status">Loading…</p>
    <p class="alert alert--info" data-review-signin hidden>This page is for the site owner and editors. <a href={loginHref(Astro.site!, '/moderate/')} data-review-signin-link>Sign in</a> with your editor email address.</p>
    <p class="alert alert--warn" data-review-notadmin hidden>You're signed in, but your account isn't on the editor list. Ask the owner to add your email address to the list (a setting called ADMIN_EMAILS). Then sign out and sign in again.</p>

    <div class="review" data-review-app hidden>
      <nav class="review-tabs" aria-label="Review center sections">
        <ul>
          {tabs.map((t) => <li><a href={`#${t.id}`} data-tab={t.id}>{t.label}<span class="review-count" data-count={t.id}></span></a></li>)}
        </ul>
      </nav>
      <p class="community__status" role="status" aria-live="polite" data-review-status></p>

      <section class="review-panel" id="todo" data-panel="todo" aria-labelledby="todo-h">
        <h2 id="todo-h" tabindex="-1">To do</h2>
        <div data-setup></div>
        <div class="review-grid" data-todo><p class="spinner" role="status">Checking what needs you…</p></div>
        <details class="review-details panel">
          <summary>Your weekly 10-minute routine</summary>
          <ol class="review-steps">
            <li><strong>New events:</strong> after the Sunday email, open <a href="#publish">New events</a>. If the automatic checks passed, press <strong>Publish now</strong>.</li>
            <li><strong>Held listings:</strong> open <a href="#listings">Held listings</a>. For each one, open the source page (where we found it). Then press the suggested button (Publish, Fix, Mark cancelled or Hide).</li>
            <li><strong>Messages:</strong> answer anything in <a href="#messages">Messages</a>. Answer requests to remove a listing first (within 7 days).</li>
            <li><strong>Community posts:</strong> approve or reject anything in <a href="#posts">Community posts</a>.</li>
            <li><strong>Sources:</strong> look at <a href="#sources">Sources</a> for anything that stopped working. Press <strong>Try again now</strong>, or <strong>Ask Copilot to fix it</strong>.</li>
          </ol>
          <p class="review-hint">Changes show on the website about 10 minutes after you press a button. Every decision is saved in the <a href="#log">Log</a>.</p>
        </details>
      </section>

      <section class="review-panel" id="listings" data-panel="listings" aria-labelledby="listings-h" hidden>
        <h2 id="listings-h" tabindex="-1">Held listings</h2>
        <p class="review-intro">The weekly check found these listings but wasn't sure about them, so they're hidden from the website. For each one, check the source page (the website we got it from). Then publish it, fix it, mark it cancelled, or hide it. Changes show on the website in about 10 minutes.</p>
        <div class="review-panel" data-listings><p class="spinner" role="status">Loading held listings…</p></div>
      </section>

      <section class="review-panel" id="publish" data-panel="publish" aria-labelledby="publish-h" hidden>
        <h2 id="publish-h" tabindex="-1">New events to publish</h2>
        <p class="review-intro">Every day the website checks some of the calendars it follows (each calendar on its own schedule). New and changed events wait here until you publish them. When the automatic checks pass, press Publish now. The events show on the website in about 10 minutes.</p>
        <div class="review-panel" data-publish><p class="spinner" role="status">Loading…</p></div>
      </section>

      <section class="review-panel" id="sources" data-panel="sources" aria-labelledby="sources-h" hidden>
        <h2 id="sources-h" tabindex="-1">Sources</h2>
        <p class="review-intro">Sources are the calendars, websites and newsletters we collect events from. Here you can see which ones stopped working, which new ones we found, and which switched-off ones you could help with.</p>
        <div class="review-panel" data-sources><p class="spinner" role="status">Loading sources…</p></div>
      </section>

      <section class="review-panel" id="messages" data-panel="messages" aria-labelledby="messages-h" hidden>
        <h2 id="messages-h" tabindex="-1">Messages from visitors</h2>
        <p class="review-intro">Visitors send these from the website: fixes to a listing, new events to add, requests to remove a listing, and website problems or ideas. They're public on GitHub, so never put private details in a reply.</p>
        <div class="review-panel" data-messages><p class="spinner" role="status">Loading messages…</p></div>
      </section>

      <section class="review-panel" id="posts" data-panel="posts" aria-labelledby="posts-h" hidden>
        <h2 id="posts-h" tabindex="-1">Community posts</h2>
        <p class="review-intro">Notes, photos and private corrections from signed-in visitors that a person needs to check. Approve, reject or hide each one. Every decision is saved in the Log.</p>
        <div class="stack-l moderate" data-moderate>
          <p class="spinner" data-mod-loading role="status">Loading posts…</p>
          <p class="alert alert--warn" data-mod-notmod hidden>You're signed in, but your account isn't a moderator.</p>
          <p class="alert alert--info" data-mod-signin hidden>Moderators only. <a href={loginHref(Astro.site!, '/moderate/')} data-mod-signin-link>Sign in</a> with the email address listed as a moderator.</p>
          <div class="btn-row" data-mod-tools hidden>
            <button type="button" class="btn btn--secondary btn--small" data-mod-refresh>Refresh</button>
            <button type="button" class="btn btn--secondary btn--small" data-mod-log>Show this month's log</button>
          </div>
          <p class="community__status" role="status" aria-live="polite" data-status></p>
          <ol class="moderate__list" data-mod-list></ol>
          <section class="panel" data-mod-log-panel hidden aria-labelledby="mod-log-h">
            <h3 id="mod-log-h">Decision log</h3>
            <ol class="moderate__log" data-mod-log-list></ol>
          </section>
          <details class="review-details panel">
            <summary>How to decide</summary>
            <ul>
              <li><strong>Approve</strong> if it follows the <a href="/community-rules/">community rules</a>.</li>
              <li><strong>Reject</strong> if it breaks them. Photos: reject if a child can be recognized, if it looks like someone did not agree to be posted, or if it is not from a dance.</li>
              <li><strong>Hide</strong> takes a public post down while you check something.</li>
              <li><strong>Corrections</strong> are private notes for editors. Fix the listing if needed, then mark it <strong>Done</strong>.</li>
              <li><strong>Ban</strong> stops a person from posting (for some days or for good) and can hide everything they posted.</li>
              <li>If a photo might show child sexual abuse: do not download or share it. Reject it, keep the log entry, and report it to the CyberTipline run by NCMEC (the National Center for Missing &amp; Exploited Children).</li>
            </ul>
          </details>
        </div>
      </section>

      <section class="review-panel" id="log" data-panel="log" aria-labelledby="log-h" hidden>
        <h2 id="log-h" tabindex="-1">Log</h2>
        <p class="review-intro">Every decision made on this page, including Community posts, newest first.</p>
        <div class="review-panel" data-log></div>
      </section>
    </div>
  </div>
</BaseLayout>
<script>
  import '../scripts/review/main';
  import '../scripts/moderate';
</script>
