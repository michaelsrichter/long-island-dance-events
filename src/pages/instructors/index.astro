---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getEventGroups } from '../../lib/content';
import { linksOf } from '../../lib/links';
import { breadcrumbJsonLd } from '../../lib/seo';

const people = (await getCollection('instructors')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const styles = new Map((await getCollection('styles')).map((s) => [s.id, s.data.name]));
const { upcoming } = await getEventGroups();
const count = (id: string) => new Set(upcoming.filter((e) => e.instructors.some((i) => i.id === id)).map((e) => e.eventId)).size;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Teachers', href: '/instructors/' },
];
---
<BaseLayout title="Dance teachers on Long Island" description={`${people.length} dance teachers with classes and lessons in Nassau and Suffolk.`} pageType="instructors" jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <PageHeader title="Teachers" lede="Teachers named in the listings. Pick a teacher to see every class they have coming up." crumbs={crumbs} />
  <div class="container section">
    <ul class="grid grid--3 person-grid">
      {people.map((p) => <PersonCard name={p.data.name} href={`/instructors/${p.id}/`} kicker="Teacher" icon="people" links={linksOf(p.data)} upcomingCount={count(p.id)} note={p.data.styles.map((s) => styles.get(s)).filter(Boolean).slice(0, 3).join(', ')} />)}
    </ul>
  </div>
</BaseLayout>
