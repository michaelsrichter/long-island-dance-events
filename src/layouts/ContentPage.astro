---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { breadcrumbJsonLd } from '../lib/seo';

interface Props {
  id: string;
  pageType: string;
  jsonLd?: unknown[];
}
const { id, pageType, jsonLd = [] } = Astro.props;
const page = await getEntry('pages', id);
if (!page) throw new Error(`Missing page content: src/content/pages/${id}.md`);
const { Content } = await render(page);
const href = `/${id}/`;
const hasAside = Astro.slots.has('aside');
const crumbs = [
  { name: 'Home', href: '/' },
  { name: page.data.title, href },
];
---
<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.seoDescription ?? page.data.lede ?? page.data.title} pageType={pageType} jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!), ...jsonLd]}>
  <PageHeader title={page.data.heading ?? page.data.title} lede={page.data.lede} crumbs={crumbs} />
  <slot name="before" />
  <div class="container section">
    <div class:list={[hasAside && 'split']}>
      <div class="stack-l">
        {page.data.highlights && page.data.highlights.length > 0 && (
          <ul class="grid grid--3" role="list">
            {page.data.highlights.map((h) => (
              <li class="card card--accent"><h2 class="h3">{h.title}</h2><p>{h.text}</p></li>
            ))}
          </ul>
        )}
        <div class="prose"><Content /></div>
        <slot />
      </div>
      {hasAside && (
        <aside class="stack-l">
          <slot name="aside" />
        </aside>
      )}
    </div>
  </div>
  <slot name="after" />
</BaseLayout>
