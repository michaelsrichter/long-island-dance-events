---
import { pageProps } from '../../../lib/page-props';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EventCard from '../../../components/EventCard.astro';
import { getEventGroups } from '../../../lib/content';
import { formatMonthKey } from '../../../lib/time';
import { breadcrumbJsonLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const { past } = await getEventGroups();
  return [...new Set(past.map((e) => e.date.slice(0, 4)))].map((year) => ({ params: { year } }));
}
if (!(await pageProps(Astro, getStaticPaths))) return Astro.rewrite('/404');
const { year } = Astro.params as { year: string };
const { past } = await getEventGroups();
const list = past.filter((e) => e.date.startsWith(year));
const months = new Map<string, typeof list>();
for (const e of list) months.set(e.date.slice(0, 7), [...(months.get(e.date.slice(0, 7)) ?? []), e]);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Past events', href: '/events/past/' },
  { name: year, href: `/events/past/${year}/` },
];
---
<BaseLayout title={`Long Island dance events in ${year}`} description={`${list.length} past dance events in Nassau and Suffolk from ${year}.`} pageType="past" jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <PageHeader title={`Past events: ${year}`} lede={`${list.length} events, newest first.`} crumbs={crumbs} />
  <div class="container section">
    {[...months].map(([key, items]) => (
      <section aria-labelledby={`m-${key}`}>
        <h2 class="month-heading" id={`m-${key}`}>{formatMonthKey(key)}</h2>
        <ul class="event-list">{items.map((e) => <EventCard event={e} past />)}</ul>
      </section>
    ))}
    <p class="mt-6"><a href="/events/past/">All past events</a></p>
  </div>
</BaseLayout>
