---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventSeriesList from '../../components/EventSeriesList.astro';
import EntityHeroMedia from '../../components/EntityHeroMedia.astro';
import EntityGallery from '../../components/EntityGallery.astro';
import PersonLinks from '../../components/PersonLinks.astro';
import Icon from '../../components/Icon.astro';
import { upcomingFor } from '../../lib/content';
import { linksOf } from '../../lib/links';
import { entityImageUrls } from '../../lib/entity-images';
import { DANCE_TYPE_LABELS } from '../../lib/schemas';
import { breadcrumbJsonLd } from '../../lib/seo';
import CommunityPanel from '../../components/CommunityPanel.astro';
import Reactions from '../../components/Reactions.astro';
import ShareControls from '../../components/ShareControls.astro';
import { styleMeta } from '../../lib/entity-meta';

export async function getStaticPaths() {
  return (await getCollection('styles')).map((s) => ({ params: { slug: s.id }, props: { style: s } }));
}
const { style } = Astro.props;
const s = style.data;
const events = await upcomingFor((e) => e.styles.some((x) => x.id === style.id));
const classes = events.filter((e) => e.category === 'class-lesson');
const dances = events.filter((e) => e.category !== 'class-lesson');
const teachers = (await getCollection('instructors')).filter((i) => i.data.styles.includes(style.id));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Dance styles', href: '/styles/' },
  { name: s.name, href: `/styles/${style.id}/` },
];
const site = Astro.site!;
const [photo, ...morePhotos] = s.photos ?? [];
const learn = linksOf({ moreLinks: s.moreLinks });
const { images } = await entityImageUrls(s, site);
const styleLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': new URL(`/styles/${style.id}/#style`, site).toString(),
  name: s.name,
  description: s.description ?? s.summary,
  url: new URL(`/styles/${style.id}/`, site).toString(),
  inDefinedTermSet: new URL('/styles/', site).toString(),
  ...(images.length ? { image: images } : {}),
  ...(learn.length ? { sameAs: learn.map((l) => l.url) } : {}),
};
const credits = (s.photos ?? []).filter((p) => p.credit);
const meta = styleMeta(style, events, site);
---
<BaseLayout title={`${s.name} on Long Island: where to dance and take classes`} description={meta.description} image={meta.image.src} imageAlt={meta.image.alt} imageType={meta.image.type} labels={meta.labels} pageType="style" jsonLd={[styleLd, breadcrumbJsonLd(crumbs, site)]}>
  <PageHeader title={s.name} lede={s.summary} crumbs={crumbs}>
    {photo && <EntityHeroMedia slot="media" name={s.name} photo={photo} />}
    <p class="page-header__meta">{DANCE_TYPE_LABELS[s.danceType]}{s.music && <> · Music: {s.music}</>}</p>
    <Reactions type="style" id={style.id} name={s.name} variant="hero" />
    <div class="btn-row mt-5"><a class="btn btn--secondary" href={`/events/?style=${style.id}`}>Filter all events by {s.name}</a><ShareControls share={meta.share} variant="button" location="style" heading={`Share ${s.name}`} /></div>
    <p class="btn-row mt-5"><a class="btn btn--secondary" href={`/events/?style=${style.id}`}>Filter all events by {s.name}</a></p>
  </PageHeader>
  <div class="container section stack-l">
    {(s.description || learn.length > 0) && (
      <section class="panel" aria-labelledby="about-h">
        <h2 id="about-h">About {s.name}</h2>
        {s.description && <p>{s.description}</p>}
        {s.music && <p class="mt-3"><span class="fact-label">Music you will hear:</span> {s.music}</p>}
        {learn.length > 0 && <div class="mt-4"><PersonLinks links={learn} name={s.name} location="style" /></div>}
      </section>
    )}
    {!s.description && learn.length === 0 && s.music && <p><span class="fact-label">Music you will hear:</span> {s.music}</p>}
    <section aria-labelledby="d-h">
      <h2 id="d-h">Dances and live music</h2>
      <div class="mt-5"><EventSeriesList events={dances} empty={`No ${s.name} dances are listed right now`} /></div>
    </section>
    <section aria-labelledby="c-h">
      <h2 id="c-h">Classes</h2>
      <div class="mt-5"><EventSeriesList events={classes} empty={`No ${s.name} classes are listed right now`} /></div>
    </section>
    {teachers.length > 0 && (
      <section class="panel" aria-labelledby="t-h">
        <h2 id="t-h">Teachers</h2>
        <p>{teachers.map((t, i) => <>{i > 0 && ', '}<a href={`/instructors/${t.id}/`}>{t.data.name}</a></>)}</p>
      </section>
    )}
    <EntityGallery photos={morePhotos} heading={`More ${s.name} photos`} />
    {credits.length > 0 && (
      <p class="entity-credits">
        <Icon name="camera" />
        <span>
          Photos are examples of the dance, not from Long Island events:{' '}
          {credits.map((c, i) => (
            <>
              {i > 0 && ' · '}
              {c.creditUrl ? <a href={c.creditUrl} target="_blank" rel="noopener nofollow">{c.credit}<span class="visually-hidden"> (opens in a new tab)</span></a> : c.credit}
              {c.licenseUrl && <> (<a href={c.licenseUrl} target="_blank" rel="noopener license">license</a>)</>}
            </>
          ))}{'.'}
        </span>
      </p>
    )}
    <CommunityPanel type="style" id={style.id} name={s.name} />
  </div>
</BaseLayout>
