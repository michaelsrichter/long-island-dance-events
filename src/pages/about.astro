---
import ContentPage from '../layouts/ContentPage.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../lib/photos';
import { getEventGroups } from '../lib/content';
import { getCollection } from 'astro:content';

const { upcoming } = await getEventGroups();
const [venues, organizers, sources] = await Promise.all([getCollection('venues'), getCollection('organizers'), getCollection('sources')]);
const events = new Set(upcoming.map((e) => e.eventId)).size;
---
<ContentPage id="about" pageType="about">
  <section aria-labelledby="numbers" class="cta-band">
    <h2 id="numbers">The list right now</h2>
    <ul class="stat-row">
      <li><strong>{events}</strong> upcoming dances and classes</li>
      <li><strong>{venues.length}</strong> venues</li>
      <li><strong>{organizers.length}</strong> organizers</li>
      <li><strong>{sources.length}</strong> {sources.length === 1 ? 'calendar' : 'calendars'} checked every week</li>
    </ul>
    <p class="muted mt-3">Repeating events, like a class every Tuesday, count once.</p>
  </section>
  <Fragment slot="aside">
    <Photo photo={photos.community} sizes="(min-width: 56rem) 35vw, 92vw" widths={[480, 720, 960]} caption="Swing dancers in Vancouver, Canada (not a Long Island event)." />
  </Fragment>
</ContentPage>
