---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TicketDate from '../../../components/TicketDate.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import DancingBadge from '../../../components/DancingBadge.astro';
import DancingPanel from '../../../components/DancingPanel.astro';
import Icon from '../../../components/Icon.astro';
import AddToCalendar from '../../../components/AddToCalendar.astro';
import ShareControls from '../../../components/ShareControls.astro';
import EventCard from '../../../components/EventCard.astro';
import RelativeWhen from '../../../components/RelativeWhen.astro';
import PersonLinks from '../../../components/PersonLinks.astro';
import CommunityPanel from '../../../components/CommunityPanel.astro';
import Reactions from '../../../components/Reactions.astro';
import { buildNow, calendarEventOf, getAllEvents, getSettings, type PersonRef, type ResolvedEvent } from '../../../lib/content';
import { breadcrumbJsonLd, eventJsonLd } from '../../../lib/seo';
import { isUpcoming } from '../../../lib/event-core';
import { CATEGORY_HELP } from '../../../lib/schemas';
import { formatDateShort } from '../../../lib/time';
import { displayHost } from '../../../lib/links';
import { eventShare } from '../../../lib/entity-meta';
import { eventDescription, eventLabels } from '../../../lib/page-meta';
import { townHref } from '../../../lib/towns';

export async function getStaticPaths() {
  const all = await getAllEvents();
  return all.map((event) => ({ params: { slug: event.slug }, props: { slug: event.slug } }));
}

const { slug } = Astro.props as { slug: string };
const all = await getAllEvents();
const now = buildNow();
const e = all.find((x) => x.slug === slug) as ResolvedEvent;
const settings = await getSettings();
const site = Astro.site!;
const d = e.data;
const upcomingNow = isUpcoming(e, now);
const cal = calendarEventOf(e, site);
const share = eventShare(e, site, now);
const upcoming = all.filter((x) => isUpcoming(x, now));
const otherDates = upcoming.filter((x) => x.eventId === e.eventId && x.slug !== e.slug).slice(0, 6);
const atVenue = e.venue ? upcoming.filter((x) => x.venue?.id === e.venue!.id && x.eventId !== e.eventId).slice(0, 3) : [];
const sameStyle = upcoming.filter((x) => x.eventId !== e.eventId && x.venue?.id !== e.venue?.id && x.styles.some((s) => e.styles.some((t) => t.id === s.id))).slice(0, 3);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: upcomingNow ? 'Events' : 'Past events', href: upcomingNow ? '/events/' : '/events/past/' },
  { name: e.title, href: e.url },
];
const title = d.seoTitle ?? `${e.title}, ${formatDateShort(e.date)}${e.location.town ? ` in ${e.location.town}` : ''}`;
const description = d.seoDescription ?? eventDescription(e);
const daysUntil = Math.ceil((e.start.getTime() - now.getTime()) / 86400000);
const telOf = (p: string) => `tel:+1${p.replace(/[^0-9]/g, '').replace(/^1(?=\d{10}$)/, '')}`;
const people: { role: string; icon: 'music' | 'people' | 'star'; p: PersonRef }[] = [
  ...e.liveActs.map((p) => ({ role: p.kind === 'band' ? 'Band' : 'Live music', icon: 'star' as const, p })),
  ...e.djs.map((p) => ({ role: 'DJ', icon: 'music' as const, p })),
  ...e.instructors.map((p) => ({ role: 'Teacher', icon: 'people' as const, p })),
];
const c = e.contact;
const org = e.organizer;
const reportUrl = `${settings.repoUrl}/issues/new?template=listing-correction.yml&title=${encodeURIComponent(`Fix listing: ${e.title} (${e.date})`)}&page=${encodeURIComponent(new URL(e.url, site).toString())}`;
const lessonLine = e.lessonLabel && e.category !== 'class-lesson' ? `Lesson at ${e.lessonLabel}` : undefined;
---
<BaseLayout
  title={title}
  description={description}
  image={share.image.src}
  imageAlt={share.image.alt}
  imageType={share.image.type}
  labels={eventLabels(e)}
  ogType="event"
  pageType="event"
  robots={upcomingNow ? undefined : 'noindex, follow'}
  bodyClass="has-action-bar"
  htmlData={{ 'data-event-slug': e.slug, 'data-event-status': e.status, 'data-days-until': String(daysUntil), 'data-entity': `event:${e.eventId}`, 'data-event-category': e.category, ...(e.location.town ? { 'data-town': e.location.town } : {}) }}
  jsonLd={[eventJsonLd(e, settings, site, new URL(share.image.src, site).toString()), breadcrumbJsonLd(crumbs, site)]}
>
  <article data-event-detail data-end={String(e.end.getTime())} aria-labelledby="event-title">
    <header class="event-hero">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <div class="event-hero__top">
          <TicketDate date={e.date} muted={!upcomingNow || e.status === 'cancelled'} />
          <div>
            <div class="event-hero__badges">
              <span class:list={['cat-badge', `cat-badge--${e.category}`]}>{e.categoryLabel}</span>
              {e.category !== 'class-lesson' && <DancingBadge dancing={e.dancing} />}
              <StatusBadge status={e.status} />
              {upcomingNow && <RelativeWhen start={e.start} end={e.end} allDay={e.timeTba} />}
            </div>
            <h1 id="event-title" class="mt-3">{e.title}</h1>
            <p class="event-hero__date"><time datetime={e.timeTba ? e.date : e.startLocal}>{e.dateLabel}{e.timeLabel ? ` · ${e.timeLabel}` : ''}</time></p>
            <Reactions type="event" id={e.eventId} name={e.title} date={e.date} save={upcomingNow && e.status !== 'cancelled'} variant="hero" />
            <ul class="hero-facts" aria-label="Key details">
              {lessonLine && <li><Icon name="people" />{lessonLine}</li>}
              {e.location.town && <li><Icon name="pin" />{e.location.name ? `${e.location.name}, ` : ''}{e.location.town}</li>}
              <li><Icon name="ticket" />{e.price.known ? e.price.label : 'Price not listed'}</li>
              {e.cadence && <li><Icon name="calendar" />{e.cadence}</li>}
            </ul>
            <p class="hero__lede">{d.summary}</p>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="event-layout">
        <div class="event-main">
          {e.status === 'cancelled' && (
            <div class="alert alert--bad" role="note">
              <p class="alert__title">This event is cancelled.</p>
              {d.cancelledNote && <p>{d.cancelledNote}</p>}
              <p><a href="/events/">See other upcoming events</a></p>
            </div>
          )}
          {!upcomingNow && e.status !== 'cancelled' && (
            <div class="alert alert--info" role="note">
              <p class="alert__title">This event has already happened.</p>
              <p><a href="/events/">See upcoming events</a></p>
            </div>
          )}
          {upcomingNow && (
            <div class="alert alert--info" role="note" data-ended-notice hidden>
              <p class="alert__title">This event has ended.</p>
              <p><a href="/events/">See upcoming events</a></p>
            </div>
          )}
          <div class="alert alert--community" role="note">
            <p class="alert__title">Check with the organizer before you go</p>
            <p>{org ? `${org.data.name} runs this event, not this website. ` : 'This website does not run this event. '}We copy the facts from a public calendar, and plans can change.</p>
          </div>

          <section class="panel" aria-labelledby="glance">
            <h2 id="glance">At a glance</h2>
            <dl class="dl">
              <div>
                <dt>When</dt>
                <dd>
                  {e.dateLabel}
                  <ul class="facts mt-3">
                    <li><Icon name="clock" /><span><span class="fact-label">Time:</span> {e.timeLabel ?? 'Not listed. Ask the organizer.'}</span></li>
                    {lessonLine && <li><Icon name="people" /><span><span class="fact-label">Lesson:</span> {e.lessonLabel}</span></li>}
                    {e.cadence && <li><Icon name="calendar" /><span><span class="fact-label">Repeats:</span> {e.cadence}</span></li>}
                  </ul>
                  {otherDates.length > 0 && (
                    <p class="mt-3">Also on: {otherDates.map((x, i) => <>{i > 0 && ', '}<a href={x.url}>{formatDateShort(x.date)}</a></>)}</p>
                  )}
                </dd>
              </div>
              <div>
                <dt>Where</dt>
                <dd>
                  {e.venue ? (
                    <>
                      <strong><a href={`/venues/${e.venue.id}/`}>{e.location.name}</a></strong><br />
                      {e.location.address}<br />
                      {e.location.town && <a href={townHref(e.location.town)}>{e.location.town}</a>}, {e.location.state} {e.location.postalCode}
                      {e.venue.data.parkingNotes && <p class="muted mt-3"><span class="fact-label">Parking:</span> {e.venue.data.parkingNotes}</p>}
                      {e.venue.data.accessibilityNotes && <p class="muted"><span class="fact-label">Access:</span> {e.venue.data.accessibilityNotes}</p>}
                    </>
                  ) : (
                    <span>{e.location.town && <a href={townHref(e.location.town)}>{e.location.town}</a>}. The exact place is not listed. Ask the organizer.</span>
                  )}
                </dd>
              </div>
              <div>
                <dt>Price</dt>
                <dd>{e.priceLine}</dd>
              </div>
              <div>
                <dt>Type and level</dt>
                <dd>
                  <p><strong>{e.categoryLabel}.</strong> {CATEGORY_HELP[e.category]}</p>
                  <p class="reassure mt-3">
                    <span class="tag tag--neutral">{e.skillLabel}</span>
                    {d.ageGroup === 'kids' && <span class="tag tag--neutral">For children</span>}
                    {d.ageGroup === 'adults' && <span class="tag tag--neutral">For adults</span>}
                  </p>
                  {e.styles.length > 0 && (
                    <div class="mt-3">
                      <p class="fact-label">Dance styles:</p>
                      <ul class="style-tags" aria-label="Dance styles">
                        {e.styles.map((s) => <li class="style-tag"><a href={`/styles/${s.id}/`}>{s.name}</a></li>)}
                      </ul>
                    </div>
                  )}
                </dd>
              </div>
              {people.length > 0 && (
                <div>
                  <dt>Who</dt>
                  <dd>
                    <ul class="lineup">
                      {people.map(({ role, icon, p }) => (
                        <li>
                          <Icon name={icon} />
                          <div>
                            <span><span class="fact-label">{role}:</span> <a href={p.href}>{p.name}</a></span>
                            <PersonLinks links={p.links} name={p.name} location="event" />
                          </div>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              <div>
                <dt>Organizer</dt>
                <dd>
                  {org ? <p><strong><a href={`/organizers/${org.id}/`}>{org.data.name}</a></strong></p> : <p>Not listed.</p>}
                  <ul class="facts mt-3">
                    {c.phone && <li><Icon name="phone" /><a href={telOf(c.phone)} data-track="outbound_click" data-track-method="phone" data-track-location="event">{c.phone}</a></li>}
                    {c.email && <li><Icon name="mail" /><a href={`mailto:${c.email}`} data-track="outbound_click" data-track-method="email" data-track-location="event">{c.email}</a></li>}
                    {e.moreInfoUrl && <li><Icon name="external" /><a href={e.moreInfoUrl} target="_blank" rel="noopener" data-track="outbound_click" data-track-method="link" data-track-location="event" data-track-target={displayHost(e.moreInfoUrl)}>More details on {displayHost(e.moreInfoUrl)}<span class="visually-hidden"> (opens in a new tab)</span></a></li>}
                  </ul>
                  {org && <PersonLinks links={c.links.filter((l) => l.url !== e.moreInfoUrl)} name={org.data.name} location="event" />}
                </dd>
              </div>
              {d.priceNotes && !e.priceLine.includes(d.priceNotes) && (
                <div>
                  <dt>Notes</dt>
                  <dd>{d.priceNotes}</dd>
                </div>
              )}
            </dl>
          </section>

          {e.category !== 'class-lesson' && <DancingPanel dancing={e.dancing} />}

          <section class="panel" aria-labelledby="source-h" id="source">
            <h2 id="source-h">Where this listing comes from</h2>
            <p>
              We found this event in{' '}
              <a href={d.sourceUrl} target="_blank" rel="noopener" data-track="outbound_click" data-track-method="source" data-track-location="event" data-track-target={displayHost(d.sourceUrl)}>{d.sourceName ?? e.source?.data.name ?? displayHost(d.sourceUrl)}<span class="visually-hidden"> (opens in a new tab)</span></a>{d.sourceRef ? ` (${d.sourceRef})` : ''}.
              The title and summary above are written by us. <a href="/sources/">How listings work</a>.
            </p>
            <p class="muted">First listed {formatDateShort(d.firstSeen, true)}. Last checked {formatDateShort(d.lastSeen, true)}.</p>
            <p class="btn-row mt-3">
              <a class="btn btn--secondary btn--small" href={reportUrl} rel="noopener" data-track="report_problem" data-track-location="event"><Icon name="info" />Report a problem with this listing</a>
            </p>
          </section>

          <CommunityPanel type="event" id={e.eventId} name={e.title} date={e.date} />
        </div>

        <aside class="event-aside no-print" aria-label="Event actions">
          {upcomingNow && (
            <section class="panel actions" id="add-to-calendar" aria-labelledby="cal-h">
              <h2 id="cal-h">Add to your calendar</h2>
              <AddToCalendar cal={cal} icsHref={`${e.url}calendar.ics`} variant="list" />
            </section>
          )}
          {e.location.directionsUrl && (
            <section class="panel actions" aria-labelledby="dir-h">
              <h2 id="dir-h">Get directions</h2>
              <div class="action-group">
                <a class="btn btn--primary btn--small" href={e.location.directionsUrl} target="_blank" rel="noopener" data-track="get_directions" data-track-method="google"><Icon name="directions" />Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
                {e.location.appleMapsUrl && <a class="btn btn--secondary btn--small" href={e.location.appleMapsUrl} target="_blank" rel="noopener" data-track="get_directions" data-track-method="apple"><Icon name="pin" />Apple Maps<span class="visually-hidden"> (opens in a new tab)</span></a>}
              </div>
            </section>
          )}
          <section class="panel actions" id="share" aria-labelledby="share-h">
            <h2 id="share-h">Share this event</h2>
            <ShareControls share={share} variant="inline" />
          </section>
          <section class="panel actions" aria-labelledby="q-h">
            <h2 id="q-h">Questions?</h2>
            {c.phone || c.email ? (
              <p>
                Contact {org?.data.name ?? 'the organizer'}:{' '}
                {c.phone && <a href={telOf(c.phone)} data-track="outbound_click" data-track-method="phone" data-track-location="event_aside">{c.phone}</a>}
                {c.phone && c.email && ' or '}
                {c.email && <a href={`mailto:${c.email}`} data-track="outbound_click" data-track-method="email" data-track-location="event_aside">{c.email}</a>}
              </p>
            ) : (
              <p>Contact {org?.data.name ?? 'the organizer'}{c.links[0] ? <> through <a href={c.links[0].url} target="_blank" rel="noopener">their {c.links[0].label.toLowerCase()}<span class="visually-hidden"> (opens in a new tab)</span></a></> : ''}.</p>
            )}
            <p><button type="button" class="btn btn--secondary btn--small js-only" data-print><Icon name="print" />Print this page</button></p>
          </section>
        </aside>
      </div>

      {(atVenue.length > 0 || sameStyle.length > 0) && (
        <section class="section no-print" aria-labelledby="more">
          <div class="section__head">
            <h2 id="more">More events you might like</h2>
            <a class="btn btn--secondary" href="/events/">All events</a>
          </div>
          {atVenue.length > 0 && (
            <>
              <h3>Also at {e.location.name}</h3>
              <ul class="event-list mt-3">{atVenue.map((x) => <EventCard event={x} headingLevel="h4" />)}</ul>
            </>
          )}
          {sameStyle.length > 0 && (
            <>
              <h3 class="mt-5">More {e.styles.slice(0, 2).map((s) => s.name).join(' and ')} nearby</h3>
              <ul class="event-list mt-3">{sameStyle.map((x) => <EventCard event={x} headingLevel="h4" />)}</ul>
            </>
          )}
        </section>
      )}
    </div>
  </article>

  <nav class="action-bar no-print" aria-label="Quick actions">
    {upcomingNow ? (
      <a href="#add-to-calendar" class="action-bar__primary"><Icon name="calendar" />Calendar</a>
    ) : (
      <a href="/events/" class="action-bar__primary"><Icon name="calendar" />Upcoming</a>
    )}
    {e.location.directionsUrl ? (
      <a href={e.location.directionsUrl} target="_blank" rel="noopener" data-track="get_directions" data-track-method="google" data-track-location="action_bar"><Icon name="directions" />Directions<span class="visually-hidden"> (opens in a new tab)</span></a>
    ) : (
      <a href="#source"><Icon name="info" />Source</a>
    )}
    <ShareControls share={share} variant="button" buttonClass="action-bar__btn" location="action_bar" noJsHref={`${e.url}#share`} />
  </nav>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>
