---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventSeriesList from '../../components/EventSeriesList.astro';
import Icon from '../../components/Icon.astro';
import DancingFacts from '../../components/DancingFacts.astro';
import EntityHeroMedia from '../../components/EntityHeroMedia.astro';
import EntityContact from '../../components/EntityContact.astro';
import EntityGallery from '../../components/EntityGallery.astro';
import { upcomingFor } from '../../lib/content';
import { breadcrumbJsonLd, venueJsonLd } from '../../lib/seo';
import { linksOf } from '../../lib/links';
import { entityImageUrls } from '../../lib/entity-images';
import CommunityPanel from '../../components/CommunityPanel.astro';
import Reactions from '../../components/Reactions.astro';

export async function getStaticPaths() {
  return (await getCollection('venues')).map((v) => ({ params: { slug: v.id }, props: { venue: v } }));
}
const { venue } = Astro.props;
const v = venue.data;
const events = await upcomingFor((e) => e.venue?.id === venue.id);
const full = [v.name, v.address, `${v.town}, ${v.state} ${v.postalCode ?? ''}`.trim()].join(', ');
const google = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(full)}`;
const apple = `https://maps.apple.com/?daddr=${encodeURIComponent(full)}`;
const site = Astro.site!;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Venues', href: '/venues/' },
  { name: v.name, href: `/venues/${venue.id}/` },
];
const links = linksOf(v);
const [photo, ...morePhotos] = v.photos ?? [];
const placeLd = venueJsonLd(venue.id, v, site, { ...(await entityImageUrls(v, site)), links });
---
<BaseLayout title={v.seoTitle ?? `${v.name}, ${v.town}: dance events`} description={v.seoDescription ?? `${v.name}, ${v.address}, ${v.town}. Directions, parking and ${events.length ? 'upcoming dance events' : 'dance events'} at this venue.`} pageType="venue" jsonLd={[placeLd, breadcrumbJsonLd(crumbs, site)]}>
  <PageHeader title={v.name} lede={`${v.address}, ${v.town}, ${v.state} ${v.postalCode ?? ''} · ${v.county} County`} crumbs={crumbs}>
    {(photo || v.logo) && <EntityHeroMedia slot="media" name={v.name} photo={photo} logo={v.logo} />}
    <Reactions type="venue" id={venue.id} name={v.name} variant="hero" />
    <div class="btn-row mt-5">
      <a class="btn btn--primary" href={google} target="_blank" rel="noopener" data-track="get_directions" data-track-method="google" data-track-location="venue"><Icon name="directions" />Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="btn btn--secondary" href={apple} target="_blank" rel="noopener" data-track="get_directions" data-track-method="apple" data-track-location="venue"><Icon name="pin" />Apple Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
      {v.googleMapsUrl && <a class="btn btn--secondary" href={v.googleMapsUrl} target="_blank" rel="noopener" data-track="outbound_click" data-track-method="reviews" data-track-location="venue" data-track-target="google.com"><Icon name="star" />Photos and reviews<span class="visually-hidden"> on Google Maps (opens in a new tab)</span></a>}
      {v.latitude !== undefined && events.length > 0 && <a class="btn btn--secondary" href={`/events/map/#place-${venue.id}`}><Icon name="pin" />See it on the dance map</a>}
    </div>
  </PageHeader>
  <div class="container section stack-l">
    <section aria-labelledby="on-h">
      <h2 id="on-h">What's on here</h2>
      <p class="muted">Repeating events show their next date.</p>
      <div class="mt-5"><EventSeriesList events={events} empty="No upcoming events are listed here right now" /></div>
    </section>
    {v.dancing && <DancingFacts name={v.name} kind="venue" floor={v.dancing.floor} kinds={v.dancing.kinds} notes={v.dancing.notes} evidence={v.dancing.evidence} confidence={v.dancing.confidence} checked={v.dancing.checked} />}
    <EntityContact
      heading="Venue details"
      name={v.name}
      location="venue"
      address={{ street: v.address, town: v.town, state: v.state, postalCode: v.postalCode }}
      phone={v.phone}
      email={v.email}
      hours={v.hours}
      links={links}
      evidence={v.evidence}
      factsSource={v.factsSource}
      logo={v.logo}
      photos={v.photos}
      ownerPrompt="Something wrong or missing?"
    >
      {v.description && <div><dt>Good to know</dt><dd>{v.description}</dd></div>}
      {v.parkingNotes && <div><dt>Parking</dt><dd>{v.parkingNotes}</dd></div>}
      {v.accessibilityNotes && <div><dt>Accessibility</dt><dd>{v.accessibilityNotes}</dd></div>}
    </EntityContact>
    <EntityGallery photos={morePhotos} heading={`More photos of ${v.name}`} />
    <CommunityPanel type="venue" id={venue.id} name={v.name} />
  </div>
</BaseLayout>
