---
/** A teacher's, band's or DJ's name, linked to their page on this site (upcoming events + their own links). */
import type { PersonRef } from '../lib/content';

interface Props {
  person: Pick<PersonRef, 'name' | 'href'>;
  /** Analytics location, e.g. "card". */
  location?: string;
}
const { person: p, location } = Astro.props;
---
<a class="person-link" href={p.href} data-track="select_person" data-track-location={location}>{p.name}</a>
