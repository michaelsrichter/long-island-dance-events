---
import Icon from './Icon.astro';
import { getSettings } from '../lib/content';
import type { EventHost } from '../lib/schemas';
interface Props {
  host: EventHost;
  size?: 'small' | 'normal';
}
const { host, size = 'normal' } = Astro.props;
const settings = await getSettings();
---
{host === 'home' ? (
  <span class:list={['host', 'host--home', size === 'small' && 'host--small']}>
    <Icon name="star" />{settings.shortName} event
  </span>
) : (
  <span class:list={['host', 'host--community', size === 'small' && 'host--small']}>
    <Icon name="people" />Community event
  </span>
)}
